# Avenu Environment Variables

# === Supabase Configuration ===
# Get these from your Supabase project settings (Settings → API)
# Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Anon/Publishable Key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# === Authentication Redirect URL ===
# Vercel: Set to your production domain (e.g., https://www.avenu.sale)
# Local dev: Leave empty or use http://localhost:5173
VITE_AUTH_REDIRECT_URL=https://www.avenu.sale

# === Optional: Site URL ===
# Fallback for VITE_AUTH_REDIRECT_URL if not set
VITE_SITE_URL=https://www.avenu.sale

# === Spline 3D hero backdrop ===
# Public Spline scene URL copied from the editor (Share → "Copy link").
# react-spline resolves the public share URL to a scene, e.g.:
#   https://my.spline.design/<name>-<id>
# Leave empty ("") to keep the CSS aurora fallback only.
# NOTE: the example scene currently fails to deserialize on the
# installed runtime, so it safely falls back to the aurora in the meantime.
VITE_SPLINE_SCENE_URL=https://my.spline.design/distortingtypography-oLHlTbIgHiL2CIpkIu7GnAUS

# === Stripe (optional, card checkout) ===
# Publishable key — safe to expose to the browser. Only needed if you enable
# Stripe's hosted checkout page.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51U55BA0FT2mdYluZwmJ4QL0cg0WET46Z8TN0LrtqE7ubrkWKCltdBDenocLowL2UTL2nAIzrJORc1gbHAkUA2Sie00RZW1UJtx

# === Crypto payment (Litecoin / wallet transfers) ===
# Public LTC address customers are told to send payment to.
VITE_CRYPTO_LTC_WALLET=ltc1qyourwalletaddresshere
# Fallback USD-per-LTC rate used when the live CoinGecko source is unreachable.
VITE_CRYPTO_FALLBACK_PRICE_USD=60
